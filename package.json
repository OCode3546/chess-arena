{
  "name": "chess-arena",
  "productName": "Chess Arena",
  "version": "0.9.0",
  "description": "A modern 2D chess game for Windows and macOS — play locally or against the computer.",
  "author": "Orville Arrindell (https://github.com/OCode3546)",
  "license": "GPL-3.0-only",
  "homepage": "https://github.com/OCode3546/chess-arena",
  "repository": {
    "type": "git",
    "url": "https://github.com/OCode3546/chess-arena.git"
  },
  "private": true,
  "main": "out/main/main.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json && tsc --noEmit -p tsconfig.test.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify:sandbox": "electron-vite build && node scripts/smoke.mjs",
    "fetch:engine": "node scripts/fetch-engine.mjs",
    "ai:sim": "vitest run --config vitest.sim.config.ts",
    "screenshots": "electron-vite build && node scripts/screenshots.mjs",
    "server:dev": "npm --prefix server run dev",
    "server:test": "npm --prefix server test",
    "dist:win": "node scripts/fetch-engine.mjs win32 x64 && electron-vite build && electron-builder --win --publish never",
    "dist:mac": "node scripts/fetch-engine.mjs darwin arm64 && electron-vite build && electron-builder --mac --publish never -c.mac.identity=-"
  },
  "//dependencies": "Only what the main process loads at runtime; the renderer is bundled by Vite, so its libraries are devDependencies and are not shipped as node_modules.",
  "dependencies": {
    "chess.js": "^1.4.0",
    "electron-store": "^8.2.0",
    "electron-updater": "^6.8.11"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/space-grotesk": "^5.3.0",
    "framer-motion": "^13.4.6",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.6",
    "zustand": "^5.0.15",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.3",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.12.0",
    "prettier": "^3.9.9",
    "stockfish": "^19.0.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^7.3.6",
    "vitest": "^5.0.2"
  },
  "allowScripts": {
    "electron@44.4.5": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true,
    "electron-winstaller@5.4.0": true
  }
}
