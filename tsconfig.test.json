{
  "extends": "./tsconfig.web.json",
  "compilerOptions": {
    "types": ["vite/client", "node"],
    "paths": {
      "@/*": ["./src/*"],
      "@shared/*": ["./src/shared/*"],
      "@game/*": ["./src/game/*"]
    }
  },
  "include": [
    "./src/**/*.ts",
    "src/**/*.tsx",
    "tests/**/*.ts",
    "sim/**/*.ts",
    "electron/engine.ts",
    "electron/migrations.ts",
    "electron/backup.ts"
  ]
}
